  "colorRoles": {
    "bg": { "cn": "纸面 / 标签擦除底色", "usage": "整幅背景、标题栏与标签底板、尺寸文字背后的擦除块" },
    "ink": { "cn": "主墨线", "usage": "可见轮廓、正文、页眉、尺寸值" },
    "surface": { "cn": "实体面", "usage": "环带 fill('evenodd') 的实体填充，用于遮挡后方线条" },
    "faint": { "cn": "极淡辅助", "usage": "厚度侧边、背面刻度、120px 主网格、剖面短斜线" },
    "grid": { "cn": "细网格", "usage": "24px 方格纸" },
    "hidden": { "cn": "隐藏线", "usage": "被实体遮住的轮廓，[4,4] 虚线" },
    "accent": { "cn": "强调 / 点睛", "usage": "印章、裁切角标、剖切、选中、实时读数、滑块拇指" },
    "panel": { "cn": "控制台底", "usage": "半透明浮层背景，配 backdrop-filter" },
    "line": { "cn": "结构分隔线", "usage": "图框、页眉分隔、尺寸线、面板描边、卡片边框" },
    "soft": { "cn": "次级文字", "usage": "引线、副行规格、状态说明、脚注" }
  },

  "contrast": {
    "method": "WCAG 2.1 相对亮度，rgba 先与 --bg 合成；数值为与同主题 --bg 的对比度",
    "paper": { "ink": 14.00, "accent": 4.94, "soft": 3.58, "hidden": 1.87 },
    "ink": { "ink": 14.27, "accent": 5.94, "soft": 5.48, "hidden": 2.22 },
    "cyan": { "ink": 11.90, "accent": 9.39, "soft": 5.50, "hidden": 2.51 },
    "notes": [
      "ink 与 accent 在三主题均达到 WCAG AA 正文（≥4.5:1）。",
      "paper 的 soft 为 3.58:1，仅达 AA 大字号（≥3:1），因此不得承载关键操作信息。",
      "hidden 是装饰性隐藏线（1.87–2.51:1），不承担信息传达，仅作图纸层次提示。"
    ]
  },

  "typography": {
    "family": "ui-monospace, SFMono-Regular, Menlo, Consolas, \"Liberation Mono\", monospace",
    "fallbackRule": "只使用系统等宽栈，禁止加载 webfont / 图标字体；中文随系统回退，不指定中文字族。",
    "scale": {
      "header": 12,
      "headerSub": 9,
      "readout": 10,
      "readoutSmall": 9,
      "dimension": 10,
      "leader": 9.5,
      "leaderSub": 8.5,
      "titleBlock": 10,
      "titleBlockSmall": 8.5,
      "hint": 9.5,
      "canvasLabel": 9,
      "panel": 10,
      "panelSmall": 9,
      "toggle": 10,
      "button": 9,
      "docBody": 13,
      "docHeading": 40
    },
    "tracking": {
      "canvasWide": 1.4,
      "canvasNormal": 1.1,
      "canvasTight": 0.8,
      "canvasMicro": 0.7,
      "panel": "0.06em",
      "panelHead": "0.16em",
      "eyebrow": "0.3em"
    },
    "weight": { "regular": 400, "semibold": 600, "bold": 700 },
    "caseRule": "图纸内全部英文大写；编号 R-NN；数值补零到 4 位。",
    "numberFormats": {
      "diameter": "Ø 480.00 ±0.05",
      "height": "H 480.00",
      "angle": "YAW θ -35.5°",
      "coordinate": "X 0480  Y 0210",
      "scale": "SCALE 1:1.00",
      "state": "STATE ASSEMBLED / EXPLODED 45%"
    },
    "rendering": "Canvas 文字用 spaced() 逐字符绘制并缓存字宽；不依赖 ctx.letterSpacing。"
  },

  "linework": {
    "cap": "butt",
    "join": "round",
    "rules": "无阴影、无渐变、无线宽随深度变化；globalAlpha 仅印章 (.75) 与十字准星 (.55) 可用。",
    "strokes": [
      { "id": "bold", "cn": "主轮廓", "color": "--ink", "width": 1.55, "selected": 2.0, "dash": [], "usage": "外轮廓、球体大圆" },
      { "id": "solid", "cn": "可见结构", "color": "--ink", "width": 1.05, "selected": 1.45, "dash": [], "usage": "内轮廓、刻度、经纬线" },
      { "id": "hidden", "cn": "隐藏结构", "color": "--hidden", "width": 0.85, "dash": [4, 4], "usage": "被实体遮住的轮廓" },
      { "id": "faint", "cn": "辅助线", "color": "--faint", "width": 0.8, "dash": [], "usage": "厚度侧边、背面刻度、剖面短斜线" },
      { "id": "center", "cn": "中心线", "color": "--faint", "width": 1.0, "dash": [12, 4, 2, 4], "usage": "两条结构基准轴" },
      { "id": "guide", "cn": "装配引导", "color": "--accent", "width": 0.8, "dash": [9, 4, 2, 4], "usage": "爆炸视图回到原位的点划线" },
      { "id": "section", "cn": "剖切扫描", "color": "--accent", "width": 1.3, "dash": [9, 4, 2, 4], "usage": "水平剖切线 + SECTION A-A" },
      { "id": "sectionHit", "cn": "剖切交点", "color": "--accent", "width": 1.4, "dash": [], "usage": "线段与扫描线求交后的短竖标记" },
      { "id": "frame", "cn": "图框", "color": "--line", "width": 1.0, "dash": [], "usage": "16px 内缩矩形" },
      { "id": "corner", "cn": "裁切角标", "color": "--accent", "width": 1.2, "dash": [], "usage": "四角 L 形短线" },
      { "id": "dimension", "cn": "尺寸线", "color": "--line", "width": 0.9, "dash": [], "usage": "带实心三角箭头的直径 / 高度标注" },
      { "id": "leader", "cn": "引线", "color": "--soft", "width": 0.8, "dash": [], "usage": "三段折线 + 端点双圆点 + 零件编号" }
    ]
  },

  "layers": [
    { "order": 1, "name": "drawPaper()", "cn": "纸面：底色、双层网格、图框、角标、页眉、印章" },
    { "order": 2, "name": "drawAxes()", "cn": "基准：中心线、地面线、剖面短斜线、DATUM" },
    { "order": 3, "name": "drawPrim() × N", "cn": "结构：按中心 z 排序，evenodd 实体擦除 → hidden → faint → solid → bold → 标记" },
    { "order": 4, "name": "drawSection()", "cn": "剖切：扫描线、求交标记、A-A 标签" },
    { "order": 5, "name": "drawLeaders() / drawDimensions() / drawHUD()", "cn": "标注：引线编号、尺寸线、角度扇形、读数、准星、标题栏" },
    { "order": 6, "name": "DOM panel", "cn": "控制台：浏览器合成层，永远在最上" }
  ],

