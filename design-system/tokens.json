    { "id": "C-04", "name": "Toggle", "cn": "方形开关", "states": "off / on / hover / focus", "tokens": "--line --soft --accent", "source": "index.html → .tg" },
    { "id": "C-05", "name": "Action button", "cn": "动作按钮", "states": "idle / hover / focus", "tokens": "--line --panel --accent", "source": "index.html → .btns .tg / skill.html → .btn" },
    { "id": "C-06", "name": "Spec card", "cn": "零件规格卡", "states": "empty / populated / selected", "tokens": "--line --soft --accent", "source": "index.html → .spec" },
